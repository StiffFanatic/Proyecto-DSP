{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build ESP32 Firmware",
      "type": "shell",
      "command": "python",
      "args": ["-m", "platformio", "run"],
      "options": {
        "cwd": "${workspaceFolder}/ESP32"
      },
      "problemMatcher": ["$platformio"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Upload ESP32 Firmware",
      "type": "shell",
      "command": "python",
      "args": ["-m", "platformio", "run", "--target", "upload"],
      "options": {
        "cwd": "${workspaceFolder}/ESP32"
      },
      "problemMatcher": ["$platformio"],
      "group": "build"
    },
    {
      "label": "Run DSP GUI",
      "type": "shell",
      "command": "python",
      "args": ["${workspaceFolder}/main.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$python"],
      "group": {
        "kind": "none",
        "isDefault": false
      }
    }
  ]
}
